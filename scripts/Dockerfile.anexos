FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-openpyxl python3-defusedxml poppler-utils tesseract-ocr tesseract-ocr-por tesseract-ocr-eng libreoffice-writer libreoffice-calc libreoffice-impress fonts-dejavu-core 7zip unrar-free && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY scripts/extrair_anexo.py /app/extrair_anexo.py
USER 65534:65534
ENTRYPOINT ["python3", "/app/extrair_anexo.py"]
